{
  "name": "six-hitting-contest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node scripts/test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:production": "npm run build && node scripts/browser-smoke.mjs --preview",
    "test:match": "node scripts/browser-match.mjs",
    "test:match:batting": "node scripts/browser-match.mjs --swing",
    "test:match:bat-first": "node scripts/browser-match.mjs --bat-first --swing",
    "test:match:sixes": "node scripts/browser-match.mjs --bat-first --swing --loft",
    "test:match:sudden": "node scripts/browser-match.mjs --force-tie",
    "test:rematch": "node scripts/browser-match.mjs --rematch",
    "test:playzone": "node scripts/browser-playzone.mjs",
    "test:camera-preview": "node scripts/browser-camera-preview.mjs",
    "test:bowling-playzone": "node scripts/browser-bowling-playzone.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.2",
    "babylonjs": "^6.33.0",
    "babylonjs-loaders": "^6.49.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "puppeteer": "^25.8.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
  }
}
